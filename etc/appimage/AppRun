#!/bin/bash

# AppRun - Entry point for Simbrain AppImage
# This script sets up the environment and launches Simbrain

# Get the directory where the AppImage is mounted
APPDIR="$(dirname "$(readlink -f "$0")")"

# Set up Java home to use bundled JRE
export JAVA_HOME="${APPDIR}/jre"
export PATH="${JAVA_HOME}/bin:${PATH}"

# Set working directory for simulations access
cd "${APPDIR}/usr"

# Launch Simbrain with required JVM arguments
exec "${JAVA_HOME}/bin/java" \
    --add-opens java.base/java.util=ALL-UNNAMED \
    --add-opens java.desktop/java.awt=ALL-UNNAMED \
    --add-opens java.desktop/java.awt.geom=ALL-UNNAMED \
    --add-opens java.base/java.util.concurrent=ALL-UNNAMED \
    --add-opens java.base/java.util.concurrent.atomic=ALL-UNNAMED \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    -Dsimbrain.simulations.dir="${APPDIR}/usr/simulations" \
    -jar "${APPDIR}/usr/lib/Simbrain.jar" \
    "$@"
